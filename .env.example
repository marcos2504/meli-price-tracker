# Copiar a .env y completar con los datos de la app del DevCenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://www.google.com

# PostgreSQL (Neon). Si está vacía, el pipeline guarda todo en archivos locales dentro de data/
DATABASE_URL=

# Dashboard: el usuario de solo lectura de db/manual/dashboard_reader.sql, con el endpoint -pooler de Neon
DASHBOARD_DATABASE_URL=
